# Local saved cases may contain user-entered data.
data/cases/*.json
!data/cases/.gitkeep

# Python bytecode and test/tool caches.
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments.
.venv/
venv/
env/

# Local environment and secret files; safe templates may be committed.
.env
.env.*
!.env.example
!.env.template

# Editor and operating-system temporary files.
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
